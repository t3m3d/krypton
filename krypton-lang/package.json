{
  "name": "krypton-lang",
  "displayName": "Krypton",
  "description": "Krypton 2.4.8 and Objective-K language support: highlighting, snippets, diagnostics, outline, and completion.",
  "version": "2.4.8",
  "publisher": "krypton-lang",
  "license": "MIT",
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/t3m3d/krypton"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:krypton",
    "workspaceContains:**/*.k",
    "workspaceContains:**/*.ks",
    "workspaceContains:**/*.htk"
  ],
  "contributes": {
    "languages": [
      {
        "id": "krypton",
        "aliases": [
          "Krypton",
          "krypton",
          "KryptScript"
        ],
        "extensions": [
          ".k",
          ".ks",
          ".htk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "krypton",
        "scopeName": "source.krypton",
        "path": "./syntaxes/krypton.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Krypton",
      "properties": {
        "krypton.kls.path": {
          "type": "string",
          "default": "",
          "description": "Path to an installed kls executable (kls.exe on Windows). Empty searches bundled tools, PATH, and standard macOS install locations."
        },
        "krypton.kls.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the kls language server (diagnostics, document symbols, completion). Disable for syntax highlighting only."
        },
        "krypton.kls.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log every JSON-RPC frame sent and received to the 'Krypton LSP' output channel. Noisy."
        }
      }
    },
    "snippets": [
      {
        "language": "krypton",
        "path": "./snippets/krypton.json"
      }
    ],
    "commands": [
      {
        "command": "krypton.restartLanguageServer",
        "title": "Krypton: Restart Language Server"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting and snippets work in Restricted Mode. Running kls requires a trusted workspace."
    }
  }
}
